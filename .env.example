# Copy to .env and fill in. .env is gitignored; never put real credentials in this file.
# Load it with `set -a; . ./.env; set +a` before running, or use `make run`.

APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=45s
HTTP_HANDLER_TIMEOUT=20s

SESSION_TTL=12h
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

LOGIN_ATTEMPTS_PER_MINUTE=10
SCAN_REQUESTS_PER_MINUTE=300

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=accessnow
DB_MAX_OPEN_CONNS=32
DB_MAX_IDLE_CONNS=8
DB_CONN_MAX_LIFETIME=30m
